<footer class="bg-[#101010] py-10 text-white">
  <div class="flex flex-col items-center justify-center gap-8 px-4 sm:px-10 lg:px-20">
    <div class="flex flex-col flex-wrap items-center justify-center gap-6 border-b border-[#333836] pb-10 sm:flex-row sm:px-10">
      <p class="text-center text-[#727976] sm:text-left">Apx is made possible thanks to the following projects.</p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-6 sm:mt-0">
        <a href="https://go.dev" target="_blank" class="flex items-center justify-center">
          <div class="icon transition-all duration-300 ease-in-out hover:scale-110" style="background-color:#727976;-webkit-mask:url(/assets/components/footer/icons/go.svg) no-repeat center;mask:url(/assets/components/footer/icons/go.svg) no-repeat center;-webkit-mask-size:contain;mask-size:contain;width:32px;height:32px" onmouseover="this.style.backgroundColor='#02ADD7'" onmouseout="this.style.backgroundColor='#727976'"></div>
        </a>
        <a href="https://vanillaos.org" target="_blank" class="flex items-center justify-center">
          <div class="icon transition-all duration-300 ease-in-out hover:scale-110" style="background-color:#727976;-webkit-mask:url(/assets/components/footer/icons/vanillaos.svg) no-repeat center;mask:url(/assets/components/footer/icons/vanillaos.svg) no-repeat center;-webkit-mask-size:contain;mask-size:contain;width:32px;height:32px" onmouseover="this.style.backgroundColor='#FCCB44'" onmouseout="this.style.backgroundColor='#727976'"></div>
        </a>
        <a href="https://github.com" target="_blank" class="flex items-center justify-center">
          <div class="icon transition-all duration-300 ease-in-out hover:scale-110" style="background-color:#727976;-webkit-mask:url(/assets/components/footer/icons/github.svg) no-repeat center;mask:url(/assets/components/footer/icons/github.svg) no-repeat center;-webkit-mask-size:contain;mask-size:contain;width:32px;height:32px" onmouseover="this.style.backgroundColor='#FFFFFF'" onmouseout="this.style.backgroundColor='#727976'"></div>
        </a>
        <a href="https://docker.com" target="_blank" class="flex items-center justify-center">
          <div class="icon transition-all duration-300 ease-in-out hover:scale-110" style="background-color:#727976;-webkit-mask:url(/assets/components/footer/icons/docker.svg) no-repeat center;mask:url(/assets/components/footer/icons/docker.svg) no-repeat center;-webkit-mask-size:contain;mask-size:contain;width:32px;height:32px" onmouseover="this.style.backgroundColor='#2496ED'" onmouseout="this.style.backgroundColor='#727976'"></div>
        </a>
        <a href="https://distrobox.it" target="_blank" class="flex items-center justify-center">
          <div class="icon transition-all duration-300 ease-in-out hover:scale-110" style="background-color:#727976;-webkit-mask:url(/assets/components/footer/icons/distrobox.svg) no-repeat center;mask:url(/assets/components/footer/icons/distrobox.svg) no-repeat center;-webkit-mask-size:contain;mask-size:contain;width:32px;height:32px" onmouseover="this.style.backgroundColor='#F1E1D1'" onmouseout="this.style.backgroundColor='#727976'"></div>
        </a>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-16 lg:flex lg:flex-row lg:gap-48">
      <div class="flex flex-col gap-2">
        <h3 class="text-opacity-70 text-base font-semibold text-white">Help</h3>
        <a href="https://docs.vanillaos.org/collections/apx" class="text-opacity-40 text-white hover:underline">Documentation</a>
